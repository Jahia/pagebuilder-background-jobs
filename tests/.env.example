JAHIA_VERSION=${JAHIA_VERSION:-LATEST}
JAHIA_IMAGE=${JAHIA_IMAGE:-ghcr.io/jahia/jahia-ee-dev:8-SNAPSHOT}
TESTS_IMAGE=${TESTS_IMAGE:-jahia/pagebuilder-background-jobs:latest}
MODULE_ID=${MODULE_ID:-pagebuilder-background-jobs}
MANIFEST=${MANIFEST:-provisioning-manifest-snapshot.yml}
JAHIA_URL=${JAHIA_URL:-http://jahia:8080}
SUPER_USER_PASSWORD=${SUPER_USER_PASSWORD:-root1234}
JAHIA_LICENSE=${JAHIA_LICENSE:-""}
JAHIA_HOST=${JAHIA_HOST:-jahia}
# Referenced by docker-compose.yml and passed to the cypress container. This module provisions
# only from the public Jahia Nexus group, so they are intentionally empty here; declared so
# set-env.sh exports them and they are not silently undefined.
NEXUS_USERNAME=${NEXUS_USERNAME:-""}
NEXUS_PASSWORD=${NEXUS_PASSWORD:-""}
